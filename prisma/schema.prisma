// Prisma schema — MySQL
// After setting DATABASE_URL in .env, run:
//   npx prisma generate
//   npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum LoanApplicationStatus {
  PENDING
  REVIEWING
  CALLED
  APPROVED
  DECLINED
}

// One row per submitted loan application form.
// Kept intentionally flat/simple — this is a lead-capture form, not a loan ledger.
model LoanApplication {
  id            Int                    @id @default(autoincrement())
  fullName      String                 @db.VarChar(150)
  email         String                 @db.VarChar(150)
  phone         String                 @db.VarChar(30)
  nationalId    String                 @db.VarChar(30)
  loanAmount    Decimal                @db.Decimal(12, 2)
  loanPurpose   String                 @db.VarChar(100)
  monthlyIncome Decimal?               @db.Decimal(12, 2)
  employer      String?                @db.VarChar(150)
  notes         String?                @db.Text

  status        LoanApplicationStatus  @default(PENDING)
  emailSent     Boolean                @default(false)

  ipAddress     String?                @db.VarChar(64)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("loan_applications")
}
