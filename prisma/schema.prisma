// Prisma schema — MySQL
// After setting DATABASE_URL in .env, run:
//   npx prisma generate
//   npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum LoanApplicationStatus {
  PENDING
  REVIEWING
  CALLED
  APPROVED
  DECLINED
}

// One row per submitted loan application form. Holds the key fields used
// for lists/search as real columns, plus the complete submission (every
// section of the paper form) as JSON in `formData` so nothing is lost even
// as the form evolves. The emailed PDF is generated from `formData` at
// submit time and is not re-derivable from the indexed columns alone.
model LoanApplication {
  id              Int                    @id @default(autoincrement())
  applicationType String                 @db.VarChar(10)
  loanType        String                 @db.VarChar(100)
  fullName        String                 @db.VarChar(150)
  email           String                 @db.VarChar(150)
  phone           String                 @db.VarChar(30)
  idNumber        String                 @db.VarChar(30)
  loanAmount      Decimal                @db.Decimal(12, 2)
  loanPurpose     String                 @db.VarChar(150)
  guarantorName   String                 @db.VarChar(150)
  guarantorPhone  String                 @db.VarChar(20)

  // Full submission — every section of the paper form, keyed by field name.
  formData        Json

  status          LoanApplicationStatus  @default(PENDING)
  emailSent       Boolean                @default(false)

  ipAddress       String?                @db.VarChar(64)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("loan_applications")
}
